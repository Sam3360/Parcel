{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://parcel.invalid/schemas/manifest-1.0.json",
  "title": "Parcel manifest (format version 1.x)",
  "description": "The manifest.json stored at the root of every .parcel package.",
  "type": "object",
  "required": ["format", "format_version", "package_id", "name", "created_at", "modified_at", "generator"],
  "properties": {
    "format": { "const": "parcel" },
    "format_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "package_id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 512 },
    "description": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "modified_at": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 1 },
    "previous_revision_id": { "type": "string" },
    "generator": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } },
      "additionalProperties": true
    },
    "entries": { "type": "array", "items": { "$ref": "#/$defs/entry" } },
    "references": { "type": "array", "items": { "$ref": "#/$defs/reference" } },
    "dependencies": { "type": "array", "items": { "$ref": "#/$defs/dependency" } },
    "metadata_files": { "type": "array", "items": { "$ref": "#/$defs/metadataFile" } },
    "metadata": { "type": "object", "additionalProperties": { "type": "string" } }
  },
  "additionalProperties": true,
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "logicalPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "description": "Forward-slash separated, relative, no '.', '..', empty components, backslashes, drive letters, control characters, Windows-reserved characters or device names. Case-insensitively unique within a package.",
      "not": { "pattern": "(^/|\\\\|(^|/)\\.\\.?(/|$)|//|^[A-Za-z]:|[\\u0000-\\u001f])" }
    },
    "safeUrl": { "type": "string", "pattern": "^([Hh][Tt][Tt][Pp][Ss]?://|[Ff][Tt][Pp]://|[Mm][Aa][Ii][Ll][Tt][Oo]:)[^\\u0000-\\u001f]*$", "maxLength": 4096 },
    "entry": {
      "type": "object",
      "required": ["id", "kind", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "kind": { "enum": ["file", "folder", "note", "link"] },
        "path": { "$ref": "#/$defs/logicalPath" },
        "storage_path": { "type": "string", "pattern": "^content/.+" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "mime": { "type": "string" },
        "url": { "$ref": "#/$defs/safeUrl" },
        "description": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object", "additionalProperties": { "type": "string" } },
        "modified_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "enum": ["file", "note"] } } }, "then": { "required": ["storage_path", "sha256", "size"] } },
        { "if": { "properties": { "kind": { "const": "folder" } } }, "then": { "not": { "anyOf": [{ "required": ["storage_path"] }, { "required": ["sha256"] }] } } },
        { "if": { "properties": { "kind": { "const": "link" } } }, "then": { "required": ["url"] } }
      ]
    },
    "reference": {
      "type": "object",
      "required": ["id", "title", "url"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "url": { "$ref": "#/$defs/safeUrl" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "entry_id": { "type": "string" }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["id", "kind", "from_entry", "target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["entry", "external"] },
        "from_entry": { "type": "string" },
        "target": { "type": "string" },
        "description": { "type": "string" },
        "required": { "type": "boolean", "default": true }
      }
    },
    "metadataFile": {
      "type": "object",
      "required": ["path", "size", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/logicalPath" }, "size": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } }
    }
  }
}
