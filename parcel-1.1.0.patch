+fn walk(d: &Path) -> Vec<PathBuf> {
+    let mut v = vec![];
+    for e in fs::read_dir(d).unwrap().flatten() {
+        if e.path().is_dir() {
+            v.extend(walk(&e.path()))
+        } else {
+            v.push(e.path())
+        }
+    }
+    v
